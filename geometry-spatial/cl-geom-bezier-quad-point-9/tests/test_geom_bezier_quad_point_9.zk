// cl-geom-bezier-quad-point-9: Test Suite
import "../bez_q_9.zk"

fn test_run():
    res := bezier_quad_eval_9(0.0, 9.00, 10.0, 0.5)
    diff := res - 7.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-bezier-quad-point-9!")
