fn point_in_bbox_25(x: int, y: int, min_x: int, max_x: int, min_y: int, max_y: int) -> int:
    if x < min_x: return 0
    if x > max_x: return 0
    if y < min_y: return 0
    if y > max_y: return 0
    return 25
