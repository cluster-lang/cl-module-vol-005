// cl-geom-sdf-cylinder-stage-15: Test Suite
import "../sdf_cyl_15.zk"

fn test_run():
    res := sdf_cylinder_radius_15(1.0, 1.0)
    diff := res - -54.2500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-sdf-cylinder-stage-15!")
