// cl-geom-line-proj-t-stage-86: Test Suite
import "../ln_t_86.zk"

fn test_run():
    res := line_proj_param_86(4.0, 8.0)
    diff := res - 43.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
