// cl-geom-rtree-union-min-stage-59: Test Suite
import "../rt_min_59.zk"

fn test_run():
    res := rtree_union_min_59(59.0, 64.0)
    diff := res - 59.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-rtree-union-min-stage-59!")
