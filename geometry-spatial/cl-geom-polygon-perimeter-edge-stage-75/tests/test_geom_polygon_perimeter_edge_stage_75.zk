// cl-geom-polygon-perimeter-edge-stage-75: Test Suite
import "../gm_ed_75.zk"

fn test_run():
    res := edge_dist_sq_75(3.0, 4.0)
    diff := res - 1875.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-polygon-perimeter-edge-stage-75!")
