// cl-geom-rtree-union-min-stage-60: Test Suite
import "../rt_min_60.zk"

fn test_run():
    res := rtree_union_min_60(60.0, 65.0)
    diff := res - 60.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-rtree-union-min-stage-60!")
