// cl-geom-tri-inradius-stage-99: Test Suite
import "../tri_ir_99.zk"

fn test_run():
    res := triangle_inradius_99(6.0, 6.0)
    diff := res - 99.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-tri-inradius-stage-99!")
