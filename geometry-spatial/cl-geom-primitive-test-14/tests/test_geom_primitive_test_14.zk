// cl-geom-primitive-test-14: Test Suite
import "../geom_p_14.zk"

fn test_run():
    res := geom_primitive_eval_14(2.0)
    diff := res - 28.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-primitive-test-14!")
