// cl-geo-haversine-delta-lat-stage-6: Test Suite
import "../geo_hl_6.zk"

fn test_run():
    res := haversine_lat_6(0.05)
    diff := res - 0.0150
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-6!")
