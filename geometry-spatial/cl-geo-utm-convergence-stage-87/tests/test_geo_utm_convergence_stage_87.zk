// cl-geo-utm-convergence-stage-87: Test Suite
import "../utm_cn_87.zk"

fn test_run():
    res := utm_convergence_87(0.05, 0.7071)
    diff := res - 3.0759
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-convergence-stage-87!")
