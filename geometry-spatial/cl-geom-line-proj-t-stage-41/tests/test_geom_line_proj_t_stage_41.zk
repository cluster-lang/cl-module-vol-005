// cl-geom-line-proj-t-stage-41: Test Suite
import "../ln_t_41.zk"

fn test_run():
    res := line_proj_param_41(4.0, 8.0)
    diff := res - 20.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
