// cl-geom-line-proj-t-stage-15: Test Suite
import "../ln_t_15.zk"

fn test_run():
    res := line_proj_param_15(4.0, 8.0)
    diff := res - 7.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-line-proj-t-stage-15!")
