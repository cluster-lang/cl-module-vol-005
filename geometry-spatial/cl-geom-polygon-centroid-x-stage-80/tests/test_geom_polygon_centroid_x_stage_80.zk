// cl-geom-polygon-centroid-x-stage-80: Test Suite
import "../gm_cx_80.zk"

fn test_run():
    res := centroid_x_80(2.0, 5.0, 3.0)
    diff := res - 1680.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
