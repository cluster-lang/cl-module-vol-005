// cl-geo-haversine-delta-lat-stage-19: Test Suite
import "../geo_hl_19.zk"

fn test_run():
    res := haversine_lat_19(0.05)
    diff := res - 0.0475
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-19!")
