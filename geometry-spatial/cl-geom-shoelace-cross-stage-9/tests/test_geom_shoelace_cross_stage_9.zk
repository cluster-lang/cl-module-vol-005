// cl-geom-shoelace-cross-stage-9: Test Suite
import "../gm_sh_9.zk"

fn test_run():
    res := shoelace_cross_9(2.0, 3.0, 5.0, 7.0)
    diff := res - -9.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-shoelace-cross-stage-9!")
