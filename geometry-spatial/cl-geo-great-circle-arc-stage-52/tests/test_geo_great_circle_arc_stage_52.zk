import "../geo_gc_52.zk"

fn test_run():
    res := great_circle_arc_52(0.04)
    diff := res - 4.1600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
