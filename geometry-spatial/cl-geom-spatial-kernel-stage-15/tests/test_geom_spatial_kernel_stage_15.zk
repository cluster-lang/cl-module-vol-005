// cl-geom-spatial-kernel-stage-15: Test Suite
import "../gk_15.zk"

fn test_run():
    res := geom_kernel_stage_15(2.0)
    diff := res - 30.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-spatial-kernel-stage-15!")
