// cl-geo-haversine-delta-lat-stage-31: Test Suite
import "../geo_hl_31.zk"

fn test_run():
    res := haversine_lat_31(0.05)
    diff := res - 0.0775
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-31!")
