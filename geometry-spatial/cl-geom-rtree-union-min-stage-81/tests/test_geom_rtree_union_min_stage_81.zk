// cl-geom-rtree-union-min-stage-81: Test Suite
import "../rt_min_81.zk"

fn test_run():
    res := rtree_union_min_81(81.0, 86.0)
    diff := res - 81.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
