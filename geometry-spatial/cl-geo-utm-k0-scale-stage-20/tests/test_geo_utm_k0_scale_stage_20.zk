// cl-geo-utm-k0-scale-stage-20: Test Suite
import "../geo_ut_20.zk"

fn test_run():
    res := utm_scale_20(0.9996, 0.0004)
    diff := res - 20.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-k0-scale-stage-20!")
