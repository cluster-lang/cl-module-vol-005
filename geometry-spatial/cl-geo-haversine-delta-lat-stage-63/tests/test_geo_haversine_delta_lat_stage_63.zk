// cl-geo-haversine-delta-lat-stage-63: Test Suite
import "../geo_hl_63.zk"

fn test_run():
    res := haversine_lat_63(0.05)
    diff := res - 0.1575
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-63!")
