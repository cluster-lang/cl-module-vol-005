// cl-geom-tri-inradius-stage-76: Test Suite
import "../tri_ir_76.zk"

fn test_run():
    res := triangle_inradius_76(6.0, 6.0)
    diff := res - 76.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-tri-inradius-stage-76!")
