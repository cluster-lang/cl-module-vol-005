// cl-geom-catmull-rom-stage-29: Test Suite
import "../cmr_29.zk"

fn test_run():
    res := catmull_rom_tangent_29(1.0, 5.0)
    diff := res - 58.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-catmull-rom-stage-29!")
