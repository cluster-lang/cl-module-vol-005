// cl-geom-ray-sphere-disc-26: Test Suite
import "../ray_sph_26.zk"

fn test_run():
    res := ray_sphere_disc_26(26.00, 1.0)
    diff := res - 675.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-ray-sphere-disc-26!")
