import "../geo_gc_13.zk"

fn test_run():
    res := great_circle_arc_13(0.04)
    diff := res - 1.0400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
