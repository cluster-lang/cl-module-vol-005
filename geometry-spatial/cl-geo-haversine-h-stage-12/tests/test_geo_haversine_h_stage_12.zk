// cl-geo-haversine-h-stage-12: Test Suite
import "../hav_h_12.zk"

fn test_run():
    res := haversine_h_12(0.5)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-h-stage-12!")
