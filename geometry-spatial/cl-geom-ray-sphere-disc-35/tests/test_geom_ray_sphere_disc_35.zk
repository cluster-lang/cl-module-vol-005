// cl-geom-ray-sphere-disc-35: Test Suite
import "../ray_sph_35.zk"

fn test_run():
    res := ray_sphere_disc_35(35.00, 1.0)
    diff := res - 1224.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-ray-sphere-disc-35!")
