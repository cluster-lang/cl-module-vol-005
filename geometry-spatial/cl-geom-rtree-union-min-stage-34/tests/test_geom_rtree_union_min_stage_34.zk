// cl-geom-rtree-union-min-stage-34: Test Suite
import "../rt_min_34.zk"

fn test_run():
    res := rtree_union_min_34(34.0, 39.0)
    diff := res - 34.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-rtree-union-min-stage-34!")
