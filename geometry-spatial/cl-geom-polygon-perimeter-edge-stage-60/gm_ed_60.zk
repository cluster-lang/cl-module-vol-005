// cl-geom-polygon-perimeter-edge-stage-60: Polygon Edge Length Squared 2D Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn edge_dist_sq_60(dx: float, dy: float) -> float:
    return (dx * dx + dy * dy) * 60.0
