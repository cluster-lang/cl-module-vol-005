// cl-geom-line-segment-intersection-stage-32: Test Suite
import "../gm_or_32.zk"

fn test_run():
    res := orientation_cross_32(2.0, 5.0, 3.0, 1.0)
    diff := res - 224.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-line-segment-intersection-stage-32!")
