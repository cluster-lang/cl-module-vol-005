// cl-geo-great-circle-arc-stage-16: Test Suite
import "../geo_gc_16.zk"

fn test_run():
    res := great_circle_arc_16(0.04)
    diff := res - 1.2800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-great-circle-arc-stage-16!")
