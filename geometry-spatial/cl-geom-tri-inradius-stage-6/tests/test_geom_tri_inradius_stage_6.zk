// cl-geom-tri-inradius-stage-6: Test Suite
import "../tri_ir_6.zk"

fn test_run():
    res := triangle_inradius_6(6.0, 6.0)
    diff := res - 6.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-tri-inradius-stage-6!")
