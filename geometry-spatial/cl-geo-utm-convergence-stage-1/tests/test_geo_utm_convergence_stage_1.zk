// cl-geo-utm-convergence-stage-1: Test Suite
import "../utm_cn_1.zk"

fn test_run():
    res := utm_convergence_1(0.05, 0.7071)
    diff := res - 0.0354
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-convergence-stage-1!")
