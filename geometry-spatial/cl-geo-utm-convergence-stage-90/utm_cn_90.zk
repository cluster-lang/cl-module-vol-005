// cl-geo-utm-convergence-stage-90: UTM Grid Convergence Approximation Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn utm_convergence_90(d_lon: float, sin_lat: float) -> float:
    return d_lon * sin_lat * 90.0
