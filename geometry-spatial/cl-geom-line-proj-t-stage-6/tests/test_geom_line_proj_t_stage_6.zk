// cl-geom-line-proj-t-stage-6: Test Suite
import "../ln_t_6.zk"

fn test_run():
    res := line_proj_param_6(4.0, 8.0)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-line-proj-t-stage-6!")
