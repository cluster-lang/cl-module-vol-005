// cl-geo-haversine-delta-lon-stage-27: Test Suite
import "../geo_hn_27.zk"

fn test_run():
    res := haversine_lon_27(0.8, 0.8, 0.05)
    diff := res - 0.0432
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lon-stage-27!")
