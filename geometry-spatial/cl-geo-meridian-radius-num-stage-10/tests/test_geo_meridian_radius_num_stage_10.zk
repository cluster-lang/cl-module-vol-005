// cl-geo-meridian-radius-num-stage-10: Test Suite
import "../mer_rn_10.zk"

fn test_run():
    res := meridian_radius_num_10(6378.0, 0.0067)
    diff := res - 63352.6740
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
