// cl-geo-haversine-delta-lon-stage-92: Test Suite
import "../geo_hn_92.zk"

fn test_run():
    res := haversine_lon_92(0.8, 0.8, 0.05)
    diff := res - 0.1472
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lon-stage-92!")
