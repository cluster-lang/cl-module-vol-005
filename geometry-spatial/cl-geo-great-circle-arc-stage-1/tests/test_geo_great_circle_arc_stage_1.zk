// cl-geo-great-circle-arc-stage-1: Test Suite
import "../geo_gc_1.zk"

fn test_run():
    res := great_circle_arc_1(0.04)
    diff := res - 0.0800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-great-circle-arc-stage-1!")
