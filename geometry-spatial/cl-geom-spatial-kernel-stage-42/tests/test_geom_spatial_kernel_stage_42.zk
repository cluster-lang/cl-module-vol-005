// cl-geom-spatial-kernel-stage-42: Test Suite
import "../gk_42.zk"

fn test_run():
    res := geom_kernel_stage_42(2.0)
    diff := res - 84.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-spatial-kernel-stage-42!")
