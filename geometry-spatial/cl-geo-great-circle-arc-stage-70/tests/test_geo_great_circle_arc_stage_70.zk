// cl-geo-great-circle-arc-stage-70: Test Suite
import "../geo_gc_70.zk"

fn test_run():
    res := great_circle_arc_70(0.04)
    diff := res - 5.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-great-circle-arc-stage-70!")
