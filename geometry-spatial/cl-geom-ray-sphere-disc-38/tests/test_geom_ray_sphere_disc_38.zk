// cl-geom-ray-sphere-disc-38: Test Suite
import "../ray_sph_38.zk"

fn test_run():
    res := ray_sphere_disc_38(38.00, 1.0)
    diff := res - 1443.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-ray-sphere-disc-38!")
