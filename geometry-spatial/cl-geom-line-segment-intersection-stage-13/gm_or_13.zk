// cl-geom-line-segment-intersection-stage-13: 2D Orientation Cross Determinant Stage 13
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn orientation_cross_13(dx1: float, dy2: float, dy1: float, dx2: float) -> float:
    return (dx1 * dy2 - dy1 * dx2) * 13.0
