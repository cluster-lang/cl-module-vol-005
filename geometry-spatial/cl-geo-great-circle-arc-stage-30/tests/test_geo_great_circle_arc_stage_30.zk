import "../geo_gc_30.zk"

fn test_run():
    res := great_circle_arc_30(0.04)
    diff := res - 2.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-great-circle-arc-stage-30!")
