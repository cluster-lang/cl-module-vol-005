// cl-geom-gjk-support-diff-stage-3: Test Suite
import "../gjk_s_3.zk"

fn test_run():
    res := gjk_support_diff_3(10.0, 3.0)
    diff := res - 21.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-gjk-support-diff-stage-3!")
