// cl-geo-utm-convergence-stage-52: Test Suite
import "../utm_cn_52.zk"

fn test_run():
    res := utm_convergence_52(0.05, 0.7071)
    diff := res - 1.8385
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-convergence-stage-52!")
