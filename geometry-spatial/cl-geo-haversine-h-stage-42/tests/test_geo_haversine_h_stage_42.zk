import "../hav_h_42.zk"

fn test_run():
    res := haversine_h_42(0.5)
    diff := res - 10.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-h-stage-42!")
