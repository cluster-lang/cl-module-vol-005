// cl-geo-haversine-delta-lat-stage-53: Test Suite
import "../geo_hl_53.zk"

fn test_run():
    res := haversine_lat_53(0.05)
    diff := res - 0.1325
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-53!")
