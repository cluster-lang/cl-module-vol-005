// cl-geo-rhumb-line-dist-stage-60: Test Suite
import "../geo_rh_60.zk"

fn test_run():
    res := rhumb_dist_sq_60(3.0, 4.0)
    diff := res - 1500.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-rhumb-line-dist-stage-60!")
