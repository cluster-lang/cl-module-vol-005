// cl-geom-catmull-rom-stage-25: Test Suite
import "../cmr_25.zk"

fn test_run():
    res := catmull_rom_tangent_25(1.0, 5.0)
    diff := res - 50.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-catmull-rom-stage-25!")
