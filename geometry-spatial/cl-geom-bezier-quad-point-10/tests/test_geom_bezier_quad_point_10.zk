// cl-geom-bezier-quad-point-10: Test Suite
import "../bez_q_10.zk"

fn test_run():
    res := bezier_quad_eval_10(0.0, 10.00, 10.0, 0.5)
    diff := res - 7.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-bezier-quad-point-10!")
