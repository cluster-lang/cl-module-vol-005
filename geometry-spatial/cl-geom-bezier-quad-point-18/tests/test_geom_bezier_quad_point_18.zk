// cl-geom-bezier-quad-point-18: Test Suite
import "../bez_q_18.zk"

fn test_run():
    res := bezier_quad_eval_18(0.0, 18.00, 10.0, 0.5)
    diff := res - 11.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-bezier-quad-point-18!")
