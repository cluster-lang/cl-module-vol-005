// cl-geom-primitive-test-13: Test Suite
import "../geom_p_13.zk"

fn test_run():
    res := geom_primitive_eval_13(2.0)
    diff := res - 26.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-primitive-test-13!")
