// cl-geo-rhumb-line-dist-stage-24: Test Suite
import "../geo_rh_24.zk"

fn test_run():
    res := rhumb_dist_sq_24(3.0, 4.0)
    diff := res - 600.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-rhumb-line-dist-stage-24!")
