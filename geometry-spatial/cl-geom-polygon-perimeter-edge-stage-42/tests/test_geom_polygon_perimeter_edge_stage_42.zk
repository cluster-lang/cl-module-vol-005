// cl-geom-polygon-perimeter-edge-stage-42: Test Suite
import "../gm_ed_42.zk"

fn test_run():
    res := edge_dist_sq_42(3.0, 4.0)
    diff := res - 1050.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-polygon-perimeter-edge-stage-42!")
