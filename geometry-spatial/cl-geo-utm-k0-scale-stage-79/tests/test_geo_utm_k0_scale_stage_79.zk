// cl-geo-utm-k0-scale-stage-79: Test Suite
import "../geo_ut_79.zk"

fn test_run():
    res := utm_scale_79(0.9996, 0.0004)
    diff := res - 79.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-k0-scale-stage-79!")
