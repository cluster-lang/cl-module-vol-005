// cl-geom-rtree-union-min-stage-25: Test Suite
import "../rt_min_25.zk"

fn test_run():
    res := rtree_union_min_25(25.0, 30.0)
    diff := res - 25.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-rtree-union-min-stage-25!")
