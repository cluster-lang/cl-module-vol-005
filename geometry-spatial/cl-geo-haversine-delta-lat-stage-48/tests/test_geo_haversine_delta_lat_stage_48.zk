// cl-geo-haversine-delta-lat-stage-48: Test Suite
import "../geo_hl_48.zk"

fn test_run():
    res := haversine_lat_48(0.05)
    diff := res - 0.1200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-48!")
