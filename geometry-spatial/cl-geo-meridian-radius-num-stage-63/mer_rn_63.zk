// cl-geo-meridian-radius-num-stage-63: Meridian Radius of Curvature Numerator Stage 63
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn meridian_radius_num_63(a_axis: float, ecc_sq: float) -> float:
    return a_axis * (1.0 - ecc_sq) * 63.0
