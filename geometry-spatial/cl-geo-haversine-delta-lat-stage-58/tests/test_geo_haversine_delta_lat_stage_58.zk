// cl-geo-haversine-delta-lat-stage-58: Test Suite
import "../geo_hl_58.zk"

fn test_run():
    res := haversine_lat_58(0.05)
    diff := res - 0.1450
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-haversine-delta-lat-stage-58!")
