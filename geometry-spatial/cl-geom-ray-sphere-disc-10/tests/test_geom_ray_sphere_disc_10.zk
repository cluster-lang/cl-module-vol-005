// cl-geom-ray-sphere-disc-10: Test Suite
import "../ray_sph_10.zk"

fn test_run():
    res := ray_sphere_disc_10(10.00, 1.0)
    diff := res - 99.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-ray-sphere-disc-10!")
