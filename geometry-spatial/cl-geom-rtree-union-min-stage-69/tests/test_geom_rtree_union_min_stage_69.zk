// cl-geom-rtree-union-min-stage-69: Test Suite
import "../rt_min_69.zk"

fn test_run():
    res := rtree_union_min_69(69.0, 74.0)
    diff := res - 69.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
