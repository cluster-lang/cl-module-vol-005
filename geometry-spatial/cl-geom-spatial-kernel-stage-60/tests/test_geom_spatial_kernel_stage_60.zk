// cl-geom-spatial-kernel-stage-60: Test Suite
import "../gk_60.zk"

fn test_run():
    res := geom_kernel_stage_60(2.0)
    diff := res - 120.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom-spatial-kernel-stage-60!")
