// cl-geo-utm-convergence-stage-47: Test Suite
import "../utm_cn_47.zk"

fn test_run():
    res := utm_convergence_47(0.05, 0.7071)
    diff := res - 1.6617
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-convergence-stage-47!")
