// cl-geo-utm-convergence-stage-75: Test Suite
import "../utm_cn_75.zk"

fn test_run():
    res := utm_convergence_75(0.05, 0.7071)
    diff := res - 2.6516
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-convergence-stage-75!")
