// cl-geo-utm-convergence-stage-7: Test Suite
import "../utm_cn_7.zk"

fn test_run():
    res := utm_convergence_7(0.05, 0.7071)
    diff := res - 0.2475
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-utm-convergence-stage-7!")
