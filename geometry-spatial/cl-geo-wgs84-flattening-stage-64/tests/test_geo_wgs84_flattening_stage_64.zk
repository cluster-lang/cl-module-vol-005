// cl-geo-wgs84-flattening-stage-64: Test Suite
import "../wgs_fl_64.zk"

fn test_run():
    res := wgs84_flattening_prod_64(6378.137, 6356.752)
    diff := res - 1368.6400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geo-wgs84-flattening-stage-64!")
