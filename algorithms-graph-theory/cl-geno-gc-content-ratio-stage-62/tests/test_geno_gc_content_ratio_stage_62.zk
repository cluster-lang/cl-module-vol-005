// cl-geno-gc-content-ratio-stage-62: Test Suite
import "../gn_gc_62.zk"

fn test_run():
    res := gc_content_62(45.0, 100.0)
    diff := res - 2790.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geno-gc-content-ratio-stage-62!")
