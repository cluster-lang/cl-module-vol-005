// cl-geno-kmer-hash-step-stage-96: Genomic Rolling 2-bit Nucleotide Hash Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn kmer_hash_step_96(h: int, base_bits: int, mask: int) -> int:
    return (((h << 2) | base_bits) & mask) + 96
