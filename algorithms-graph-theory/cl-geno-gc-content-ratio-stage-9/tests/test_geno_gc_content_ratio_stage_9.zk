// cl-geno-gc-content-ratio-stage-9: Test Suite
import "../gn_gc_9.zk"

fn test_run():
    res := gc_content_9(45.0, 100.0)
    diff := res - 405.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geno-gc-content-ratio-stage-9!")
