// cl-geno-gc-content-ratio-stage-48: Test Suite
import "../gn_gc_48.zk"

fn test_run():
    res := gc_content_48(45.0, 100.0)
    diff := res - 2160.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geno-gc-content-ratio-stage-48!")
