// cl-geom3d-cylinder-volume: Test Suite
import "../cyl_vol.zk"

fn test_cylv():
    res := cylinder_volume(2.0, 5.0)
    // pi * 4 * 5 = 20 * 3.14159265 = 62.831853
    diff := res - 62.831853
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_cylv passed")

fn main():
    test_cylv()
    print("✓ All tests passed for cl-geom3d-cylinder-volume!")
