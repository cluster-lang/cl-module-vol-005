// cl-gfx-fbm-octave-stage-47: Test Suite
import "../fbm_oc_47.zk"

fn test_run():
    res := fbm_octave_scale_47(0.8, 0.5)
    diff := res - 18.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-gfx-fbm-octave-stage-47!")
