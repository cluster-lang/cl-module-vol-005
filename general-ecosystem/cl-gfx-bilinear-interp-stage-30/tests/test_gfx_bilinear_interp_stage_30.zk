// cl-gfx-bilinear-interp-stage-30: Test Suite
import "../bili_int_30.zk"

fn test_run():
    res := bilinear_interp_30(1.0, 3.0, 0.5)
    diff := res - 60.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-gfx-bilinear-interp-stage-30!")
