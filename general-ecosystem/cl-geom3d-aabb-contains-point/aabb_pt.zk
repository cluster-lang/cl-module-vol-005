// cl-geom3d-aabb-contains-point: 3D AABB Point Containment
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn aabb3d_contains_point(p: vector[float], min_pt: vector[float], max_pt: vector[float]) -> int:
    if p[0] >= min_pt[0] and p[0] <= max_pt[0] and p[1] >= min_pt[1] and p[1] <= max_pt[1] and p[2] >= min_pt[2] and p[2] <= max_pt[2]:
        return 1
    return 0
