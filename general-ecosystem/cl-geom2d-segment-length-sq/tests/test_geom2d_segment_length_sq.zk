// cl-geom2d-segment-length-sq: Test Suite
import "../seg_len_sq.zk"

fn test_sls():
    res := segment2d_length_sq([1.0, 2.0], [4.0, 6.0])
    diff := res - 25.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_sls passed")

fn main():
    test_sls()
    print("✓ All tests passed for cl-geom2d-segment-length-sq!")
