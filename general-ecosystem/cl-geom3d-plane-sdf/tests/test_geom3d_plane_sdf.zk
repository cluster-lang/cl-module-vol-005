// cl-geom3d-plane-sdf: Test Suite
import "../plane_sdf.zk"

fn test_run():
    res := plane_sdf([0.0, 0.0, 5.0], [0.0, 0.0, 1.0], 0.0)
    diff := res - 5.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-plane-sdf!")
