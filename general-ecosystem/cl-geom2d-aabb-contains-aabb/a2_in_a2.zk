// cl-geom2d-aabb-contains-aabb: Check If 2D Box Fully Contains Another 2D Box
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn aabb2d_contains_aabb2d(min_a: vector[float], max_a: vector[float], min_b: vector[float], max_b: vector[float]) -> int:
    if min_b[0] < min_a[0] or max_b[0] > max_a[0]: return 0
    if min_b[1] < min_a[1] or max_b[1] > max_a[1]: return 0
    return 1
