// cl-geom2d-aabb-contains-aabb: Test Suite
import "../a2_in_a2.zk"

fn test_run():
    res := aabb2d_contains_aabb2d([-10.0, -10.0], [10.0, 10.0], [-5.0, -5.0], [5.0, 5.0])
    if res != 1: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom2d-aabb-contains-aabb!")
