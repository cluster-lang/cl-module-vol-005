// cl-gfx-fbm-octave-stage-32: Test Suite
import "../fbm_oc_32.zk"

fn test_run():
    res := fbm_octave_scale_32(0.8, 0.5)
    diff := res - 12.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-gfx-fbm-octave-stage-32!")
