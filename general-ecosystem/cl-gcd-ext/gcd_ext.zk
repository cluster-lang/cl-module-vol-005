model BezoutCoeffs:
    gcd_val: int
    x: int
    y: int

fn extended_gcd(a: int, b: int) -> BezoutCoeffs:
    old_r := a; r := b
    old_s := 1; s := 0
    old_t := 0; t := 1

    while r != 0:
        quot := old_r / r
        tmp_r := r; r = old_r - (quot * r); old_r = tmp_r
        tmp_s := s; s = old_s - (quot * s); old_s = tmp_s
        tmp_t := t; t = old_t - (quot * t); old_t = tmp_t

    return BezoutCoeffs(old_r, old_s, old_t)
