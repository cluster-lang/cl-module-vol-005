// cl-geom2d-circle-contains-point: Check If 2D Circle Contains Point
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn circle_contains_pt(center: vector[float], radius: float, p: vector[float]) -> int:
    dx := p[0] - center[0]
    dy := p[1] - center[1]
    dsq := dx*dx + dy*dy
    if dsq <= (radius * radius): return 1
    return 0
