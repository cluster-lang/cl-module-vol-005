// cl-geom2d-ray-ray-intersect: Test Suite
import "../rr2.zk"

fn test_rr2():
    hit := ray_ray_intersect2d([0.0, 0.0], [1.0, 0.0], [2.0, -2.0], [0.0, 1.0])
    miss := ray_ray_intersect2d([0.0, 0.0], [1.0, 0.0], [2.0, 2.0], [0.0, 1.0])
    if hit != 1 or miss != 0: sys_exit(1)
    print("test_rr2 passed")

fn main():
    test_rr2()
    print("✓ All tests passed for cl-geom2d-ray-ray-intersect!")
