// cl-geom2d-point-in-circle: 2D Point in Circle Tester
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn point_in_circle2d(p: vector[float], center: vector[float], r: float) -> int:
    dx := p[0] - center[0]; dy := p[1] - center[1]
    if (dx * dx + dy * dy) <= (r * r): return 1
    return 0
