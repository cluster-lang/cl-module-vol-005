// cl-geom3d-ray-plane-intersect: 3D Ray-Plane Intersection Tester
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ray_plane_intersect3d(ro: vector[float], rd: vector[float], plane: vector[float]) -> int:
    denom := plane[0]*rd[0] + plane[1]*rd[1] + plane[2]*rd[2]
    d_abs := denom
    if d_abs < 0.0: d_abs = 0.0 - d_abs
    if d_abs < 0.000001: return 0
    num := 0.0 - (plane[0]*ro[0] + plane[1]*ro[1] + plane[2]*ro[2] + plane[3])
    t := num / denom
    if t >= 0.0: return 1
    return 0
