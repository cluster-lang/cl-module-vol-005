// cl-geom2d-circle-circle-intersect: Test Suite
import "../circle_circle.zk"

fn test_cc():
    hit := circle_circle_intersect2d([0.0, 0.0], 2.0, [3.0, 0.0], 2.0)
    miss := circle_circle_intersect2d([0.0, 0.0], 1.0, [5.0, 0.0], 1.0)
    if hit != 1 or miss != 0: sys_exit(1)
    print("test_cc passed")

fn main():
    test_cc()
    print("✓ All tests passed for cl-geom2d-circle-circle-intersect!")
