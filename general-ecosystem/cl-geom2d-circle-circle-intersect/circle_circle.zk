// cl-geom2d-circle-circle-intersect: 2D Circle-Circle Overlap Test
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn circle_circle_intersect2d(c1: vector[float], r1: float, c2: vector[float], r2: float) -> int:
    dx := c1[0] - c2[0]; dy := c1[1] - c2[1]
    d_sq := dx * dx + dy * dy
    r_sum := r1 + r2
    if d_sq <= r_sum * r_sum: return 1
    return 0
