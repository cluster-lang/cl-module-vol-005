// cl-geom2d-point-in-box: 2D Point in AABB Boundary Tester
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn point_in_box2d(p: vector[float], min_pt: vector[float], max_pt: vector[float]) -> int:
    if p[0] >= min_pt[0] and p[0] <= max_pt[0] and p[1] >= min_pt[1] and p[1] <= max_pt[1]:
        return 1
    return 0
