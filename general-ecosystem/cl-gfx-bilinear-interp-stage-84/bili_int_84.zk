// cl-gfx-bilinear-interp-stage-84: 2D Texture Bilinear Interpolation Stage 84
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bilinear_interp_84(c00: float, c10: float, tx: float) -> float:
    return (c00 + tx * (c10 - c00)) * 84.0
