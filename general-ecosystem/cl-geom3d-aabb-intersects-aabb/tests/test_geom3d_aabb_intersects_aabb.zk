// cl-geom3d-aabb-intersects-aabb: Test Suite
import "../aabb_aabb.zk"

fn test_aaba():
    hit := aabb3d_intersects_aabb([0.0, 0.0, 0.0], [2.0, 2.0, 2.0], [1.0, 1.0, 1.0], [3.0, 3.0, 3.0])
    miss := aabb3d_intersects_aabb([0.0, 0.0, 0.0], [1.0, 1.0, 1.0], [3.0, 3.0, 3.0], [4.0, 4.0, 4.0])
    if hit != 1 or miss != 0: sys_exit(1)
    print("test_aaba passed")

fn main():
    test_aaba()
    print("✓ All tests passed for cl-geom3d-aabb-intersects-aabb!")
