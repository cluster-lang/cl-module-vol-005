// cl-geom3d-aabb-intersects-aabb: 3D AABB-AABB Intersection
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn aabb3d_intersects_aabb(min1: vector[float], max1: vector[float], min2: vector[float], max2: vector[float]) -> int:
    if max1[0] < min2[0] or min1[0] > max2[0]: return 0
    if max1[1] < min2[1] or min1[1] > max2[1]: return 0
    if max1[2] < min2[2] or min1[2] > max2[2]: return 0
    return 1
