// cl-geom3d-aabb-contains-aabb: Test Suite
import "../aabb_in_aabb.zk"

fn test_run():
    res := aabb_contains_aabb([-10.0, -10.0, -10.0], [10.0, 10.0, 10.0], [-5.0, -5.0, -5.0], [5.0, 5.0, 5.0])
    if res != 1: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-aabb-contains-aabb!")
