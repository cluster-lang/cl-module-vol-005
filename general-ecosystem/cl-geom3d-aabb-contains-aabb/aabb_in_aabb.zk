// cl-geom3d-aabb-contains-aabb: Check If AABB Fully Contains Another AABB in 3D
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn aabb_contains_aabb(min_a: vector[float], max_a: vector[float], min_b: vector[float], max_b: vector[float]) -> int:
    if min_b[0] < min_a[0] or max_b[0] > max_a[0]: return 0
    if min_b[1] < min_a[1] or max_b[1] > max_a[1]: return 0
    if min_b[2] < min_a[2] or max_b[2] > max_a[2]: return 0
    return 1
