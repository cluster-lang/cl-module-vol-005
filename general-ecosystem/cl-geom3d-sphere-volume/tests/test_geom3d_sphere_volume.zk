// cl-geom3d-sphere-volume: Test Suite
import "../sph_vol.zk"

fn test_sphv():
    res := sphere_volume(3.0)
    // (4/3) * pi * 27 = 36 * 3.14159265 = 113.097335
    diff := res - 113.097335
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_sphv passed")

fn main():
    test_sphv()
    print("✓ All tests passed for cl-geom3d-sphere-volume!")
