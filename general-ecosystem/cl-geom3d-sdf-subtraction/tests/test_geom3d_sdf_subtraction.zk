// cl-geom3d-sdf-subtraction: Test Suite
import "../csg_sub.zk"

fn test_run():
    res := sdf_subtraction(1.5, 0.5)
    diff := res - 1.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-sdf-subtraction!")
