// cl-geom3d-sdf-sphere: Exact Signed Distance to Origin-Centered Sphere
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_sdf(p: vector[float], radius: float) -> float:
    dsq := p[0]*p[0] + p[1]*p[1] + p[2]*p[2]
    guess := dsq * 0.5
    iter := 0
    while iter < 6:
        if guess <= 0.0001: guess = 0.0001
        guess = (guess + dsq / guess) * 0.5
        iter = iter + 1
    return guess - radius
