// cl-geom3d-sdf-sphere: Test Suite
import "../sph_sdf.zk"

fn test_run():
    res := sphere_sdf([5.0, 0.0, 0.0], 2.0)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-sdf-sphere!")
