// cl-geom3d-cone-volume: Test Suite
import "../cone_vol.zk"

fn test_conev():
    res := cone_volume(3.0, 5.0)
    // (1/3) * pi * 9 * 5 = 15 * pi = 47.12389
    diff := res - 47.12389
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_conev passed")

fn main():
    test_conev()
    print("✓ All tests passed for cl-geom3d-cone-volume!")
