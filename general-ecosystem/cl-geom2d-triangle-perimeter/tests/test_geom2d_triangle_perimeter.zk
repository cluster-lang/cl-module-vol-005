// cl-geom2d-triangle-perimeter: Test Suite
import "../tri_perim.zk"

fn test_tp():
    // 3-4-5 right triangle: perimeter = 12.0
    res := triangle2d_perimeter([0.0, 0.0], [4.0, 0.0], [0.0, 3.0])
    diff := res - 12.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_tp passed")

fn main():
    test_tp()
    print("✓ All tests passed for cl-geom2d-triangle-perimeter!")
