// cl-gfx-bilinear-interp-stage-47: 2D Texture Bilinear Interpolation Stage 47
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bilinear_interp_47(c00: float, c10: float, tx: float) -> float:
    return (c00 + tx * (c10 - c00)) * 47.0
