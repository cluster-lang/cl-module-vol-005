fn point_plane_project(out_pt: vector[float], p: vector[float], plane: vector[float]):
    d := plane[0]*p[0] + plane[1]*p[1] + plane[2]*p[2] + plane[3]
    out_pt[0] = p[0] - d * plane[0]
    out_pt[1] = p[1] - d * plane[1]
    out_pt[2] = p[2] - d * plane[2]
