// cl-geom3d-point-plane-project: Test Suite
import "../pt_pln_proj.zk"

fn test_ppp_pt():
    // Plane z = 0
    pln: vector[float] := [0.0, 0.0, 1.0, 0.0]
    out: vector[float] := [0.0, 0.0, 0.0]
    point_plane_project(out, [2.0, 3.0, 5.0], pln)
    if out[0] != 2.0 or out[1] != 3.0 or out[2] != 0.0: sys_exit(1)
    print("test_ppp_pt passed")

fn main():
    test_ppp_pt()
    print("✓ All tests passed for cl-geom3d-point-plane-project!")
