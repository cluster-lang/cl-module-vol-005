// cl-geom3d-aabb-surface-area: Test Suite
import "../aabb_sa.zk"

fn test_aabsa():
    sa := aabb3d_surface_area([0.0, 0.0, 0.0], [2.0, 3.0, 4.0])
    // 2*(6 + 12 + 8) = 2*26 = 52.0
    diff := sa - 52.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_aabsa passed")

fn main():
    test_aabsa()
    print("✓ All tests passed for cl-geom3d-aabb-surface-area!")
