// cl-geom3d-aabb-surface-area: 3D AABB Surface Area Calculator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn aabb3d_surface_area(min_pt: vector[float], max_pt: vector[float]) -> float:
    dx := max_pt[0] - min_pt[0]
    dy := max_pt[1] - min_pt[1]
    dz := max_pt[2] - min_pt[2]
    return 2.0 * (dx * dy + dy * dz + dz * dx)
