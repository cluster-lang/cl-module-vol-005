// cl-geom3d-sphere-sphere-intersect: Test Suite
import "../sph_sph.zk"

fn test_ss3():
    hit := sphere_sphere_intersect3d([0.0, 0.0, 0.0], 2.0, [3.0, 0.0, 0.0], 2.0)
    miss := sphere_sphere_intersect3d([0.0, 0.0, 0.0], 1.0, [5.0, 0.0, 0.0], 1.0)
    if hit != 1 or miss != 0: sys_exit(1)
    print("test_ss3 passed")

fn main():
    test_ss3()
    print("✓ All tests passed for cl-geom3d-sphere-sphere-intersect!")
