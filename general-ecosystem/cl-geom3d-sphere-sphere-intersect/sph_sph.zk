// cl-geom3d-sphere-sphere-intersect: 3D Sphere-Sphere Overlap Tester
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_sphere_intersect3d(c1: vector[float], r1: float, c2: vector[float], r2: float) -> int:
    dx := c1[0] - c2[0]; dy := c1[1] - c2[1]; dz := c1[2] - c2[2]
    dist_sq := dx*dx + dy*dy + dz*dz
    r_sum := r1 + r2
    if dist_sq <= r_sum * r_sum: return 1
    return 0
