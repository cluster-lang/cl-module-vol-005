// cl-geom3d-torus-sdf: Test Suite
import "../torus_sdf.zk"

fn test_run():
    res := torus_sdf([2.0, 0.0, 0.0], 2.0, 0.5)
    diff := res - -0.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-torus-sdf!")
