// cl-geom3d-torus-sdf: Signed Distance Function for Torus around Z-axis
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torus_sdf(p: vector[float], major_r: float, minor_r: float) -> float:
    q_x_sq := p[0]*p[0] + p[1]*p[1]
    guess := q_x_sq * 0.5
    iter := 0
    while iter < 6:
        if guess <= 0.0001: guess = 0.0001
        guess = (guess + q_x_sq / guess) * 0.5
        iter = iter + 1
    qx := guess - major_r
    dsq := qx * qx + p[2] * p[2]
    guess2 := dsq * 0.5
    iter2 := 0
    while iter2 < 6:
        if guess2 <= 0.0001: guess2 = 0.0001
        guess2 = (guess2 + dsq / guess2) * 0.5
        iter2 = iter2 + 1
    return guess2 - minor_r
