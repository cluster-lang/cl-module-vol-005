// cl-geom3d-point-plane-unsigned-dist: Test Suite
import "../pt_pl_udist.zk"

fn test_run():
    res := point_plane_unsigned_dist([0.0, 0.0, -10.0], [0.0, 0.0, 1.0], 2.0)
    diff := res - 12.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-point-plane-unsigned-dist!")
