// cl-frustum-planes: Test Suite
import "../frustum_planes.zk"

fn test_frustum_planes():
    pl: vector[float] := [0.0, 3.0, 4.0, 10.0]
    plane_normalize(pl, 0)
    // Length was sqrt(9+16) = 5.0, so ny = 0.6, nz = 0.8, d = 2.0
    if pl[1] < 0.59: sys_exit(1)
    if pl[1] > 0.61: sys_exit(1)
    if pl[3] < 1.99: sys_exit(1)
    if pl[3] > 2.01: sys_exit(1)
    print("test_frustum_planes passed: plane normalisation verified")

fn main():
    test_frustum_planes()
    print("✓ All tests passed for cl-frustum-planes!")
