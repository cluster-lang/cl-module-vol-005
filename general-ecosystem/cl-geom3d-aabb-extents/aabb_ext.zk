// cl-geom3d-aabb-extents: 3D AABB Half-Extents Evaluator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn aabb3d_half_extents(out_e: vector[float], min_pt: vector[float], max_pt: vector[float]):
    out_e[0] = (max_pt[0] - min_pt[0]) * 0.5
    out_e[1] = (max_pt[1] - min_pt[1]) * 0.5
    out_e[2] = (max_pt[2] - min_pt[2]) * 0.5
