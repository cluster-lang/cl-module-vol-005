// cl-geom3d-sphere-contains-point: Check If 3D Sphere Contains Point
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_contains_pt(center: vector[float], radius: float, p: vector[float]) -> int:
    dx := p[0] - center[0]
    dy := p[1] - center[1]
    dz := p[2] - center[2]
    dsq := dx*dx + dy*dy + dz*dz
    if dsq <= (radius * radius): return 1
    return 0
