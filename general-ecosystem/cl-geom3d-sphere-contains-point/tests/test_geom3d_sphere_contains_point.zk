// cl-geom3d-sphere-contains-point: Test Suite
import "../sph_pt.zk"

fn test_run():
    res := sphere_contains_pt([0.0, 0.0, 0.0], 5.0, [3.0, 4.0, 0.0])
    if res != 1: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-sphere-contains-point!")
