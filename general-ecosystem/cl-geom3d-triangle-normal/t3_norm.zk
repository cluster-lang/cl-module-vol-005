// cl-geom3d-triangle-normal: 3D Triangle Surface Normal Vector
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn triangle3d_normal(out_n: vector[float], v0: vector[float], v1: vector[float], v2: vector[float]):
    e1x := v1[0] - v0[0]; e1y := v1[1] - v0[1]; e1z := v1[2] - v0[2]
    e2x := v2[0] - v0[0]; e2y := v2[1] - v0[1]; e2z := v2[2] - v0[2]
    out_n[0] = e1y * e2z - e1z * e2y
    out_n[1] = e1z * e2x - e1x * e2z
    out_n[2] = e1x * e2y - e1y * e2x
