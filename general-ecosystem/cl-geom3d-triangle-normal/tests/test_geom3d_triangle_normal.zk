// cl-geom3d-triangle-normal: Test Suite
import "../t3_norm.zk"

fn test_t3n():
    v0: vector[float] := [0.0, 0.0, 0.0]
    v1: vector[float] := [1.0, 0.0, 0.0]
    v2: vector[float] := [0.0, 1.0, 0.0]
    n: vector[float] := [0.0, 0.0, 0.0]
    triangle3d_normal(n, v0, v1, v2)
    if n[0] != 0.0 or n[1] != 0.0 or n[2] != 1.0: sys_exit(1)
    print("test_t3n passed")

fn main():
    test_t3n()
    print("✓ All tests passed for cl-geom3d-triangle-normal!")
