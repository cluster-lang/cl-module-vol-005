// cl-geom3d-point-plane-distance: 3D Point to Plane Signed Distance
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn point_plane_distance(p: vector[float], plane: vector[float]) -> float:
    return plane[0]*p[0] + plane[1]*p[1] + plane[2]*p[2] + plane[3]
