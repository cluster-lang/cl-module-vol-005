// cl-geom3d-box-sdf: Test Suite
import "../box_sdf.zk"

fn test_run():
    res := box_sdf([3.0, 0.0, 0.0], [1.0, 1.0, 1.0])
    diff := res - 2.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom3d-box-sdf!")
