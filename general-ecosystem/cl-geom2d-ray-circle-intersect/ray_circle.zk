// cl-geom2d-ray-circle-intersect: 2D Ray-Circle Intersection Test
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ray_circle_intersect2d(ro: vector[float], rd: vector[float], cc: vector[float], r: float) -> int:
    ox := ro[0] - cc[0]; oy := ro[1] - cc[1]
    a := rd[0] * rd[0] + rd[1] * rd[1]
    b := 2.0 * (ox * rd[0] + oy * rd[1])
    c := ox * ox + oy * oy - r * r
    disc := b * b - 4.0 * a * c
    if disc < 0.0: return 0
    return 1
