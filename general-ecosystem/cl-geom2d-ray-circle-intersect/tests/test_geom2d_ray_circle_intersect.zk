// cl-geom2d-ray-circle-intersect: Test Suite
import "../ray_circle.zk"

fn test_rc():
    hit := ray_circle_intersect2d([0.0, -5.0], [0.0, 1.0], [0.0, 0.0], 2.0)
    miss := ray_circle_intersect2d([5.0, -5.0], [0.0, 1.0], [0.0, 0.0], 2.0)
    if hit != 1 or miss != 0: sys_exit(1)
    print("test_rc passed")

fn main():
    test_rc()
    print("✓ All tests passed for cl-geom2d-ray-circle-intersect!")
