// cl-geom2d-point-in-triangle: Test Suite
import "../pit.zk"

fn test_pit():
    a: vector[float] := [0.0, 0.0]
    b: vector[float] := [4.0, 0.0]
    c: vector[float] := [0.0, 4.0]
    if point_in_triangle2d([1.0, 1.0], a, b, c) != 1: sys_exit(1)
    if point_in_triangle2d([5.0, 5.0], a, b, c) != 0: sys_exit(1)
    print("test_pit passed")

fn main():
    test_pit()
    print("✓ All tests passed for cl-geom2d-point-in-triangle!")
