// cl-fluid-reynolds-stage-16: Test Suite
import "../reyn_16.zk"

fn test_run():
    res := reynolds_num_16(1.0, 10.0, 2.0, 1.0)
    diff := res - 320.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fluid-reynolds-stage-16!")
