// cl-gfx-fbm-octave-stage-100: Test Suite
import "../fbm_oc_100.zk"

fn test_run():
    res := fbm_octave_scale_100(0.8, 0.5)
    diff := res - 40.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-gfx-fbm-octave-stage-100!")
