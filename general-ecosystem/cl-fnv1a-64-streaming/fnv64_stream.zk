fn fnv1a_64_init() -> int:
    // Offset basis: 0xcbf29ce484222325 -> signed: -3750763034362895579
    return -3750763034362895579

fn fnv1a_64_update(h: int, b: int) -> int:
    // Prime: 0x100000001b3 -> 1099511628211
    prime := 1099511628211
    h_next := h ^ (b & 255)
    return h_next * prime
