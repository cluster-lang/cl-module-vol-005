// cl-geom2d-triangle-area: Test Suite
import "../tri_area.zk"

fn test_ta():
    res := triangle2d_area([0.0, 0.0], [4.0, 0.0], [0.0, 3.0])
    diff := res - 6.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_ta passed")

fn main():
    test_ta()
    print("✓ All tests passed for cl-geom2d-triangle-area!")
