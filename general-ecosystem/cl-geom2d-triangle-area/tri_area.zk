// cl-geom2d-triangle-area: 2D Triangle Shoelace Area Calculator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn triangle2d_area(v0: vector[float], v1: vector[float], v2: vector[float]) -> float:
    a := 0.5 * (v0[0] * (v1[1] - v2[1]) + v1[0] * (v2[1] - v0[1]) + v2[0] * (v0[1] - v1[1]))
    if a < 0.0: a = 0.0 - a
    return a
