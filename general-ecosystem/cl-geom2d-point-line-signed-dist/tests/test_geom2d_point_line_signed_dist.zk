// cl-geom2d-point-line-signed-dist: Test Suite
import "../pt_l2_sdist.zk"

fn test_run():
    res := point_line_signed_dist([0.0, 5.0], 0.0, 1.0, 0.0)
    diff := res - 5.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-geom2d-point-line-signed-dist!")
