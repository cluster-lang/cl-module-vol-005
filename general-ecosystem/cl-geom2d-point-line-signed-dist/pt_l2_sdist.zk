// cl-geom2d-point-line-signed-dist: Signed Distance from Point to 2D Line (ax + by + c = 0)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn point_line_signed_dist(p: vector[float], a: float, b: float, c: float) -> float:
    n_sq := a*a + b*b
    if n_sq <= 0.000001: return 0.0
    guess := n_sq * 0.5
    iter := 0
    while iter < 6:
        guess = (guess + n_sq / guess) * 0.5
        iter = iter + 1
    return (a*p[0] + b*p[1] + c) / guess
