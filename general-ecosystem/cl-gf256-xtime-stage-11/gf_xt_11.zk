// cl-gf256-xtime-stage-11: Galois Field GF(2^8) Multiplier xtime Stage 11
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn gf256_xtime_11(a: int) -> int:
    res := (a << 1) & 255
    if (a & 128) != 0:
        res = res ^ 27
    return res
