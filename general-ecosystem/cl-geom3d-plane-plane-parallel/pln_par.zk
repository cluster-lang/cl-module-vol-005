// cl-geom3d-plane-plane-parallel: 3D Plane Parallelism Detector
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn planes_are_parallel(p1: vector[float], p2: vector[float]) -> int:
    cx := p1[1]*p2[2] - p1[2]*p2[1]
    cy := p1[2]*p2[0] - p1[0]*p2[2]
    cz := p1[0]*p2[1] - p1[1]*p2[0]
    cross_sq := cx*cx + cy*cy + cz*cz
    if cross_sq < 0.000001: return 1
    return 0
