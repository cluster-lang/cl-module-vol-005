// cl-geom3d-triangle-area-heron: Test Suite
import "../t_heron.zk"

fn test_heron():
    // 3-4-5 right triangle in 3D: area = 6.0
    res := triangle3d_area_heron([0.0, 0.0, 0.0], [4.0, 0.0, 0.0], [0.0, 3.0, 0.0])
    diff := res - 6.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_heron passed")

fn main():
    test_heron()
    print("✓ All tests passed for cl-geom3d-triangle-area-heron!")
