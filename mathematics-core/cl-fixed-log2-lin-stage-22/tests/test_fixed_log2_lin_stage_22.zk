// cl-fixed-log2-lin-stage-22: Test Suite
import "../log2_ln_22.zk"

fn test_run():
    res := log2_linear_22(1.5)
    diff := res - 15.8696
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-log2-lin-stage-22!")
