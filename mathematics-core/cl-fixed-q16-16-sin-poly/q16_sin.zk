// cl-fixed-q16-16-sin-poly: Q16.16 Fixed-Point Sine Polynomial Approx
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q16_sin(x: int) -> int:
    // x in [0, 65536] represents [0, pi/2]
    // sin(x) approx x - x^3/6 -> x - (x*x*x >> 32)/6
    x2 := (x * x) >> 16
    x3 := (x2 * x) >> 16
    return x - (x3 / 6)
