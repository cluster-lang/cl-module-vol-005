// cl-fixed-saturated-acc-stage-11: Saturated Integer Accumulator Stage 11
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_11(a: int, b: int) -> int:
    sum := a + b
    if sum > 11000: return 11000
    if sum < (0 - 11000): return (0 - 11000)
    return sum
