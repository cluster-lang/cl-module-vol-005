// cl-fixed-erf-series-stage-19: Test Suite
import "../erf_s_19.zk"

fn test_run():
    res := erf_series_19(0.5)
    diff := res - 9.8265
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-19!")
