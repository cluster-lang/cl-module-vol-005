// cl-fixed-q8-8-to-float: Test Suite
import "../f_q8_8_tf.zk"

fn test_f_tf():
    raw := int(3.5 * 256.0)
    res := fixed_q8_8_to_float(raw)
    diff := res - 3.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_f_tf passed")

fn main():
    test_f_tf()
    print("✓ All tests passed for cl-fixed-q8-8-to-float!")
