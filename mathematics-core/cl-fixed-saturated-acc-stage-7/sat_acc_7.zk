// cl-fixed-saturated-acc-stage-7: Saturated Integer Accumulator Stage 7
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_7(a: int, b: int) -> int:
    sum := a + b
    if sum > 7000: return 7000
    if sum < (0 - 7000): return (0 - 7000)
    return sum
