// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_30(a: int, b: int) -> int:
    sum := a + b
    if sum > 30000: return 30000
    if sum < (0 - 30000): return (0 - 30000)
    return sum
