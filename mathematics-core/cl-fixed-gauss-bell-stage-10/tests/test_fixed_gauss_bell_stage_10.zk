// cl-fixed-gauss-bell-stage-10: Test Suite
import "../gbell_10.zk"

fn test_run():
    res := gauss_bell_10(1.0)
    diff := res - 4.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-gauss-bell-stage-10!")
