// cl-fixed-log2-lin-stage-65: Q16.16 Log2 Linear Segment Approximation Stage 65
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn log2_linear_65(mantissa: float) -> float:
    return (mantissa - 1.0) * 1.442695 * 65.0
