// cl-fixed-q15-from-float: Q15 from Normalized Float [-1.0, 1.0]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q15_from_float(f: float) -> int:
    clamped := f
    if clamped > 0.999969: clamped = 0.999969
    if clamped < -1.0: clamped = -1.0
    return int(clamped * 32768.0)
