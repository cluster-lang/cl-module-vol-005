// cl-fixed-softplus-pw-stage-88: Test Suite
import "../sft_pw_88.zk"

fn test_run():
    res := softplus_pw_88(4.0)
    diff := res - 352.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
