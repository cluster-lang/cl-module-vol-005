// cl-fixed-log2-lin-stage-14: Test Suite
import "../log2_ln_14.zk"

fn test_run():
    res := log2_linear_14(1.5)
    diff := res - 10.0989
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-log2-lin-stage-14!")
