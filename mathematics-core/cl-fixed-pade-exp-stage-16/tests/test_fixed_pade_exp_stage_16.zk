// cl-fixed-pade-exp-stage-16: Test Suite
import "../pade_e_16.zk"

fn test_run():
    res := pade_exp_16(0.2)
    diff := res - 19.5556
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
