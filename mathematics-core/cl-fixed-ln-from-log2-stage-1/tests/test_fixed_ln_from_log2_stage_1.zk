// cl-fixed-ln-from-log2-stage-1: Test Suite
import "../ln_lg2_1.zk"

fn test_run():
    res := ln_from_log2_1(10.0)
    diff := res - 6.9315
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-ln-from-log2-stage-1!")
