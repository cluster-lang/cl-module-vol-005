// cl-fixed-q16-16-cos-poly: Q16.16 Fixed-Point Cosine Polynomial Approx
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q16_cos(x: int) -> int:
    // cos(x) approx 1 - x^2/2
    x2 := (x * x) >> 16
    return 65536 - (x2 / 2)
