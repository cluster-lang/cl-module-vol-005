// cl-fixed-gauss-bell-stage-48: Test Suite
import "../gbell_48.zk"

fn test_run():
    res := gauss_bell_48(1.0)
    diff := res - 19.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-gauss-bell-stage-48!")
