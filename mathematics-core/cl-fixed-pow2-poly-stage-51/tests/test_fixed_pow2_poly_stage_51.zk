// cl-fixed-pow2-poly-stage-51: Test Suite
import "../pw2_pl_51.zk"

fn test_run():
    res := pow2_frac_poly_51(0.5)
    diff := res - 71.7381
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-51!")
