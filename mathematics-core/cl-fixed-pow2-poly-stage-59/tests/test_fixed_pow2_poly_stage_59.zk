// cl-fixed-pow2-poly-stage-59: Test Suite
import "../pw2_pl_59.zk"

fn test_run():
    res := pow2_frac_poly_59(0.5)
    diff := res - 82.9912
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-59!")
