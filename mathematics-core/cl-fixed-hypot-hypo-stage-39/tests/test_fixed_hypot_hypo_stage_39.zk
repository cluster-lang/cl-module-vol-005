import "../hyp_st_39.zk"

fn test_run():
    res := hypot_sq_step_39(3.0, 4.0)
    diff := res - 975.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
