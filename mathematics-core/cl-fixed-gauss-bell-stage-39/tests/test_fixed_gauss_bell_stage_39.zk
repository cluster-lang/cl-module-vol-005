// cl-fixed-gauss-bell-stage-39: Test Suite
import "../gbell_39.zk"

fn test_run():
    res := gauss_bell_39(1.0)
    diff := res - 15.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-gauss-bell-stage-39!")
