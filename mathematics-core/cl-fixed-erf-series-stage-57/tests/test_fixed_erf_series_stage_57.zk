// cl-fixed-erf-series-stage-57: Test Suite
import "../erf_s_57.zk"

fn test_run():
    res := erf_series_57(0.5)
    diff := res - 29.4795
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
