// cl-fixed-saturated-acc-stage-6: Saturated Integer Accumulator Stage 6
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_6(a: int, b: int) -> int:
    sum := a + b
    if sum > 6000: return 6000
    if sum < (0 - 6000): return (0 - 6000)
    return sum
