// cl-fixed-pow2-poly-stage-39: Test Suite
import "../pw2_pl_39.zk"

fn test_run():
    res := pow2_frac_poly_39(0.5)
    diff := res - 54.8586
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-39!")
