// cl-fixed-erf-series-stage-52: Test Suite
import "../erf_s_52.zk"

fn test_run():
    res := erf_series_52(0.5)
    diff := res - 26.8935
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-52!")
