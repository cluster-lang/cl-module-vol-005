// cl-fixed-saturated-acc-stage-31: Saturated Integer Accumulator Stage 31
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_31(a: int, b: int) -> int:
    sum := a + b
    if sum > 31000: return 31000
    if sum < (0 - 31000): return (0 - 31000)
    return sum
