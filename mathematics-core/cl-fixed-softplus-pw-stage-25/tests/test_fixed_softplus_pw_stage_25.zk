// cl-fixed-softplus-pw-stage-25: Test Suite
import "../sft_pw_25.zk"

fn test_run():
    res := softplus_pw_25(4.0)
    diff := res - 100.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-softplus-pw-stage-25!")
