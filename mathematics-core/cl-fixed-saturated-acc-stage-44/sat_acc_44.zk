// cl-fixed-saturated-acc-stage-44: Saturated Integer Accumulator Stage 44
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_44(a: int, b: int) -> int:
    sum := a + b
    if sum > 44000: return 44000
    if sum < (0 - 44000): return (0 - 44000)
    return sum
