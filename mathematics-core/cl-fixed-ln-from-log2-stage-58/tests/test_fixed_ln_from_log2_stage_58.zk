import "../ln_lg2_58.zk"

fn test_run():
    res := ln_from_log2_58(10.0)
    diff := res - 402.0253
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-ln-from-log2-stage-58!")
