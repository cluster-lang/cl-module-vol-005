// cl-fixed-hypot-hypo-stage-20: Test Suite
import "../hyp_st_20.zk"

fn test_run():
    res := hypot_sq_step_20(3.0, 4.0)
    diff := res - 500.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-hypot-hypo-stage-20!")
