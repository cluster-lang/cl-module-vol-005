// cl-fixed-erf-series-stage-62: Test Suite
import "../erf_s_62.zk"

fn test_run():
    res := erf_series_62(0.5)
    diff := res - 32.0654
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
