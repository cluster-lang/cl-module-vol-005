// cl-fixed-pade-exp-stage-75: Test Suite
import "../pade_e_75.zk"

fn test_run():
    res := pade_exp_75(0.2)
    diff := res - 91.6667
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pade-exp-stage-75!")
