// cl-fixed-q24-8-to-float: Test Suite
import "../q24_2f.zk"

fn test_run():
    res := q24_to_float(3840)
    diff := res - 15.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-q24-8-to-float!")
