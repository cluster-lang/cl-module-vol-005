// cl-fixed-erf-series-stage-42: Test Suite
import "../erf_s_42.zk"

fn test_run():
    res := erf_series_42(0.5)
    diff := res - 21.7217
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-42!")
