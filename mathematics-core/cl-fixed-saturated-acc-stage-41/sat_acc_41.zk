// cl-fixed-saturated-acc-stage-41: Saturated Integer Accumulator Stage 41
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_41(a: int, b: int) -> int:
    sum := a + b
    if sum > 41000: return 41000
    if sum < (0 - 41000): return (0 - 41000)
    return sum
