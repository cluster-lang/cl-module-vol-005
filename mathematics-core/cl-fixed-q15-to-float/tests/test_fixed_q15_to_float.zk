// cl-fixed-q15-to-float: Test Suite
import "../q15_2f.zk"

fn test_run():
    res := q15_to_float(32768)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-q15-to-float!")
