// cl-fixed-q16-16-from-float: Test Suite
import "../f_q16_16_ff.zk"

fn test_f_ff():
    res := fixed_q16_16_from_float(2.5)
    exp := int(2.5 * 65536.0)
    if res != exp: sys_exit(1)
    print("test_f_ff passed")

fn main():
    test_f_ff()
    print("✓ All tests passed for cl-fixed-q16-16-from-float!")
