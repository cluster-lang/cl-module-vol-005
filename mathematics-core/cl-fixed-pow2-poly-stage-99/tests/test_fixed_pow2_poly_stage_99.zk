// cl-fixed-pow2-poly-stage-99: Test Suite
import "../pw2_pl_99.zk"

fn test_run():
    res := pow2_frac_poly_99(0.5)
    diff := res - 139.2564
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-99!")
