// cl-fixed-ln-from-log2-stage-4: Test Suite
import "../ln_lg2_4.zk"

fn test_run():
    res := ln_from_log2_4(10.0)
    diff := res - 27.7259
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-ln-from-log2-stage-4!")
