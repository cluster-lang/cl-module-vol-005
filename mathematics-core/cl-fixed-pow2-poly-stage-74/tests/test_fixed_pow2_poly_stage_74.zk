// cl-fixed-pow2-poly-stage-74: Test Suite
import "../pw2_pl_74.zk"

fn test_run():
    res := pow2_frac_poly_74(0.5)
    diff := res - 104.0906
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-74!")
