import "../sigm_pw_43.zk"

fn test_run():
    res := sigmoid_pw_43(0.0)
    diff := res - 21.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
