// cl-fixed-sigmoid-pw-stage-43: Piecewise Linear Sigmoid Stage 43
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sigmoid_pw_43(x: float) -> float:
    if x < (0.0 - 2.0): return 0.0
    if x > 2.0: return 1.0
    return (0.5 + 0.25 * x) * 43.0
