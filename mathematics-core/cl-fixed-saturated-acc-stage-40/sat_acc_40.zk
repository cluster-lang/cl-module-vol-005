// cl-fixed-saturated-acc-stage-40: Saturated Integer Accumulator Stage 40
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_40(a: int, b: int) -> int:
    sum := a + b
    if sum > 40000: return 40000
    if sum < (0 - 40000): return (0 - 40000)
    return sum
