// cl-fixed-pade-exp-stage-20: Test Suite
import "../pade_e_20.zk"

fn test_run():
    res := pade_exp_20(0.2)
    diff := res - 24.4444
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pade-exp-stage-20!")
