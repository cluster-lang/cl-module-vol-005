// cl-fixed-saturated-acc-stage-16: Saturated Integer Accumulator Stage 16
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_16(a: int, b: int) -> int:
    sum := a + b
    if sum > 16000: return 16000
    if sum < (0 - 16000): return (0 - 16000)
    return sum
