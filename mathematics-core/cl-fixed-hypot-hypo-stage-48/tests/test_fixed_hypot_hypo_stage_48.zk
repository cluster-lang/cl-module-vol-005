// cl-fixed-hypot-hypo-stage-48: Test Suite
import "../hyp_st_48.zk"

fn test_run():
    res := hypot_sq_step_48(3.0, 4.0)
    diff := res - 1200.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-hypot-hypo-stage-48!")
