// cl-fixed-q16-16-reciprocal: Q16.16 Fixed-Point Reciprocal (1 / x)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q16_reciprocal(x: int) -> int:
    if x == 0: return 0
    one_q32 := 4294967296
    return one_q32 / x
