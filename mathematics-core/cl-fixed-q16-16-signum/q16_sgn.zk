// cl-fixed-q16-16-signum: Q16.16 Fixed-Point Signum Function (+1.0, -1.0, 0.0)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q16_signum(x: int) -> int:
    if x > 0: return 65536
    if x < 0: return 0 - 65536
    return 0
