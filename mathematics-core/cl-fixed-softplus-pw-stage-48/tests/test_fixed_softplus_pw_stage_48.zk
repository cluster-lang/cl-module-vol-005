// cl-fixed-softplus-pw-stage-48: Test Suite
import "../sft_pw_48.zk"

fn test_run():
    res := softplus_pw_48(4.0)
    diff := res - 192.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-softplus-pw-stage-48!")
