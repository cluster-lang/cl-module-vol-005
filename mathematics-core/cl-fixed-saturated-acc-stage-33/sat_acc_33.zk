// cl-fixed-saturated-acc-stage-33: Saturated Integer Accumulator Stage 33
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_33(a: int, b: int) -> int:
    sum := a + b
    if sum > 33000: return 33000
    if sum < (0 - 33000): return (0 - 33000)
    return sum
