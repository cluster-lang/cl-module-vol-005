// cl-fixed-q8-8-sqrt-int: Q8.8 Fixed-Point Integer Square Root
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q8_sqrt(x: int) -> int:
    if x <= 0: return 0
    val := x << 8
    guess := x
    if guess == 0: guess = 1
    iter := 0
    while iter < 8:
        guess = (guess + val / guess) / 2
        iter = iter + 1
    return guess
