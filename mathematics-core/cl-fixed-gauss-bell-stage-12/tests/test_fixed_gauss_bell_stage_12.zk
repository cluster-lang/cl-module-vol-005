// cl-fixed-gauss-bell-stage-12: Test Suite
import "../gbell_12.zk"

fn test_run():
    res := gauss_bell_12(1.0)
    diff := res - 4.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-gauss-bell-stage-12!")
