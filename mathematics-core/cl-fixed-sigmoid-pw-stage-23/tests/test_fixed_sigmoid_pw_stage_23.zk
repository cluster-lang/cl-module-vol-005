// cl-fixed-sigmoid-pw-stage-23: Test Suite
import "../sigm_pw_23.zk"

fn test_run():
    res := sigmoid_pw_23(0.0)
    diff := res - 11.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-sigmoid-pw-stage-23!")
