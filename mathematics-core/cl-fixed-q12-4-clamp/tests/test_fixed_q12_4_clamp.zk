// cl-fixed-q12-4-clamp: Test Suite
import "../f_q12_4_clamp.zk"

fn test_f_clamp():
    low := 1 << 4
    high := 10 << 4
    if fixed_q12_4_clamp(0, low, high) != low: sys_exit(1)
    if fixed_q12_4_clamp(15 << 4, low, high) != high: sys_exit(1)
    print("test_f_clamp passed")

fn main():
    test_f_clamp()
    print("✓ All tests passed for cl-fixed-q12-4-clamp!")
