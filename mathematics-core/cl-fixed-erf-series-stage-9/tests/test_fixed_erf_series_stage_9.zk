// cl-fixed-erf-series-stage-9: Test Suite
import "../erf_s_9.zk"

fn test_run():
    res := erf_series_9(0.5)
    diff := res - 4.6547
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-9!")
