// cl-fixed-erf-series-stage-30: Test Suite
import "../erf_s_30.zk"

fn test_run():
    res := erf_series_30(0.5)
    diff := res - 15.5155
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-30!")
