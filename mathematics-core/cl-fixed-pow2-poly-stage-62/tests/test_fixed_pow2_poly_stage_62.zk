// cl-fixed-pow2-poly-stage-62: Test Suite
import "../pw2_pl_62.zk"

fn test_run():
    res := pow2_frac_poly_62(0.5)
    diff := res - 87.2111
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-62!")
