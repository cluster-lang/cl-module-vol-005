// cl-fixed-q16-16-tan-approx: Q16.16 Fixed-Point Tangent Linear Slope Approx
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn q16_tan(x: int) -> int:
    // tan(x) approx x + x^3/3
    x2 := (x * x) >> 16
    x3 := (x2 * x) >> 16
    return x + (x3 / 3)
