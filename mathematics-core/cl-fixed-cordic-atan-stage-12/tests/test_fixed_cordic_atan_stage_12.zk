// cl-fixed-cordic-atan-stage-12: Test Suite
import "../c_atan_12.zk"

fn test_run():
    res := cordic_atan_table_12()
    diff := res - 0.0002
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-cordic-atan-stage-12!")
