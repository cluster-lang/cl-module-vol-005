// cl-fixed-q20-12-to-float: Test Suite
import "../q20_12_2f.zk"

fn test_run():
    res := q20_12_to_float(20480)
    diff := res - 5.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-q20-12-to-float!")
