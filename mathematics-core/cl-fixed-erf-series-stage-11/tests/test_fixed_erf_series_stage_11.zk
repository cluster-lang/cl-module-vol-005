// cl-fixed-erf-series-stage-11: Test Suite
import "../erf_s_11.zk"

fn test_run():
    res := erf_series_11(0.5)
    diff := res - 5.6890
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-11!")
