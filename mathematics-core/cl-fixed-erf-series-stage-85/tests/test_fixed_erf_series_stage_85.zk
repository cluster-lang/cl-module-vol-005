// cl-fixed-erf-series-stage-85: Test Suite
import "../erf_s_85.zk"

fn test_run():
    res := erf_series_85(0.5)
    diff := res - 43.9606
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-erf-series-stage-85!")
