// cl-fixed-saturated-acc-stage-9: Saturated Integer Accumulator Stage 9
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_9(a: int, b: int) -> int:
    sum := a + b
    if sum > 9000: return 9000
    if sum < (0 - 9000): return (0 - 9000)
    return sum
