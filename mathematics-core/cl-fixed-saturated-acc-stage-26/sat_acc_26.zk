// cl-fixed-saturated-acc-stage-26: Saturated Integer Accumulator Stage 26
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sat_acc_26(a: int, b: int) -> int:
    sum := a + b
    if sum > 26000: return 26000
    if sum < (0 - 26000): return (0 - 26000)
    return sum
