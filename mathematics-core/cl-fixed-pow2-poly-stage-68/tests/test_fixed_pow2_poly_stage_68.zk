// cl-fixed-pow2-poly-stage-68: Test Suite
import "../pw2_pl_68.zk"

fn test_run():
    res := pow2_frac_poly_68(0.5)
    diff := res - 95.6508
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fixed-pow2-poly-stage-68!")
