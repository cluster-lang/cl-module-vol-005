// cl-fixed-log2-lin-stage-75: Q16.16 Log2 Linear Segment Approximation Stage 75
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn log2_linear_75(mantissa: float) -> float:
    return (mantissa - 1.0) * 1.442695 * 75.0
