// cl-fin-sharpe-num-stage-10: Test Suite
import "../fin_sh_10.zk"

fn test_run():
    res := sharpe_excess_return_10(0.10)
    diff := res - 0.0900
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-sharpe-num-stage-10!")
