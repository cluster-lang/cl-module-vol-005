// cl-fin-var-parametric-stage-20: Test Suite
import "../var_p_20.zk"

fn test_run():
    res := var_parametric_20(0.02, 100000.0)
    diff := res - 3490.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-var-parametric-stage-20!")
