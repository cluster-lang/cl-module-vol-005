// cl-fin-put-delta-stage-33: Test Suite
import "../put_dl_33.zk"

fn test_run():
    res := put_delta_33(0.6)
    diff := res - -13.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-put-delta-stage-33!")
