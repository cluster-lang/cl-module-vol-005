// cl-fin-var-parametric-stage-5: Test Suite
import "../var_p_5.zk"

fn test_run():
    res := var_parametric_5(0.02, 100000.0)
    diff := res - 3340.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-var-parametric-stage-5!")
