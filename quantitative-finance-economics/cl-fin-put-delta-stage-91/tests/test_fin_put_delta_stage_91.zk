// cl-fin-put-delta-stage-91: Test Suite
import "../put_dl_91.zk"

fn test_run():
    res := put_delta_91(0.6)
    diff := res - -36.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
