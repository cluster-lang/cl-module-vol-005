// cl-fin-put-delta-stage-65: Test Suite
import "../put_dl_65.zk"

fn test_run():
    res := put_delta_65(0.6)
    diff := res - -26.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
