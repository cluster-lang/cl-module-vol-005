// cl-fin-option-vega-stage-95: Test Suite
import "../opt_vg_95.zk"

fn test_run():
    res := option_vega_95(100.0, 1.0)
    diff := res - 3800.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-vega-stage-95!")
