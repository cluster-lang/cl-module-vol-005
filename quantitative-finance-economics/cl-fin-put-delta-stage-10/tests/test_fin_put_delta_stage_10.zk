// cl-fin-put-delta-stage-10: Test Suite
import "../put_dl_10.zk"

fn test_run():
    res := put_delta_10(0.6)
    diff := res - -4.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-put-delta-stage-10!")
